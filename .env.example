# Backend-only configuration. Copy to .env.local and restart the worker after changes.
# DEX Screener's public endpoints used here require no API key.
CHAOS_DATA_DIR=.chaos-data
CHAOS_SCAN_INTERVAL_SECONDS=300
CHAOS_STALE_AFTER_SECONDS=1200
CHAOS_MIN_MARKET_CAP_USD=1000000
CHAOS_MIN_LIQUIDITY_USD=250000
CHAOS_MIN_VOLUME_24H_USD=100000
CHAOS_MIN_AGE_DAYS=30
CHAOS_DISCOVERY_QUERIES=solana,SOL,USDC,BONK,WIF,RAY,POPCAT
# Additional exclusions; project exclusions (including JUP) always apply.
CHAOS_EXCLUDED_ADDRESSES=
# Additional comma-separated Solana mint addresses, beyond src/server/market/seed-tokens.ts.
# All tracked tokens must pass the same eligibility filters. No secret required.
CHAOS_SEED_ADDRESSES=
CHAOS_QUERIES_PER_SCAN=4
CHAOS_MAX_CANDIDATES=300
# Shared global pacing: ~37.5 requests/minute, below 60/min discovery limits.
CHAOS_PROVIDER_REQUEST_GAP_MS=1600
CHAOS_PROVIDER_CACHE_SECONDS=120
CHAOS_PROVIDER_TIMEOUT_SECONDS=12
CHAOS_HISTORY_WINDOW_MINUTES=360
CHAOS_MAX_COMPARISON_GAP_MINUTES=20
CHAOS_INDEX_MIN_POOL_SIZE=2
CHAOS_INDEX_MIN_COVERAGE=0.6
CHAOS_INDEX_MIN_AVAILABLE_WEIGHT=0.6
CHAOS_EVENT_REARM_THRESHOLD=99.99
CHAOS_SCALE_FEE_GROWTH_PERCENT=25
CHAOS_SCALE_VOLUME_CHANGE_PERCENT=30
CHAOS_SCALE_MARKET_CAP_CHANGE_PERCENT=20
CHAOS_SCALE_LIQUIDITY_CHANGE_PERCENT=15
CHAOS_SCALE_HOLDER_CHANGE_PERCENT=20
CHAOS_SCALE_TRANSACTION_CHANGE_PERCENT=30
CHAOS_SCALE_PRICE_VOLATILITY_PERCENT=5
CHAOS_WEIGHT_FEES=0.25
CHAOS_WEIGHT_VOLUME=0.25
CHAOS_WEIGHT_MARKET_CAP=0.10
CHAOS_WEIGHT_LIQUIDITY=0.10
CHAOS_WEIGHT_HOLDERS=0.10
CHAOS_WEIGHT_TRANSACTIONS=0.10
CHAOS_WEIGHT_PRICE=0.10
CHAOS_MAX_EVENTS=100

# Vercel Blob persistence is enabled automatically when a private store is
# connected to the project. Vercel supplies BLOB_STORE_ID through OIDC; do not
# create a NEXT_PUBLIC_ copy or commit a Blob token.
BLOB_STORE_ID=

# Solana financial monitoring. The website remains read-only and never stores signing keys.
CHAOS_TOKEN_CA=
FEE_WALLET_CA=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_DISTRIBUTION_THRESHOLD_SOL=5
DISTRIBUTION_PERCENTAGE=20
NEXT_THRESHOLD_MULTIPLIER=2
# Optional explicit progression, for example: 5,10,25,50,100
CHAOS_DISTRIBUTION_THRESHOLDS_SOL=
CHAOS_FINANCIAL_MONITOR_INTERVAL_SECONDS=60
CHAOS_FINANCIAL_STALE_AFTER_SECONDS=300
SOLANA_RPC_TIMEOUT_SECONDS=15
CHAOS_MAX_DISTRIBUTIONS=250
CHAOS_MAX_FINANCIAL_EVENTS=250

# Required to enable /admin. Use a unique password and a random secret of at least 32 characters.
CHAOS_ADMIN_USERNAME=admin
CHAOS_ADMIN_PASSWORD=
CHAOS_ADMIN_SESSION_SECRET=
